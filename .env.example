# Local development:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnipsyche?schema=public"
# NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL="http://localhost:3000"
#
# Production Cloud Run + Cloud SQL Unix socket:
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME"
#
# Keep production secret values in Secret Manager or Cloud Run environment
# variables. Never commit real credentials.
DATABASE_URL=""
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
AUTH_URL=""
# Required behind Cloud Run or another reverse proxy so Auth.js trusts host headers.
AUTH_TRUST_HOST="true"

# AI provider - Gemini API only. Keep the API key server-side.
GEMINI_API_KEY=""
GEMINI_API_PRIMARY_MODEL="gemini-3.5-flash"
GEMINI_API_FALLBACK_MODEL="gemini-2.5-flash"
ENABLE_AI_MODEL_FALLBACK="true"

# Legacy primary model alias. Optional; GEMINI_API_PRIMARY_MODEL wins when set.
GEMINI_PERSONALITY_MODEL=""

# Deprecated Vertex AI variables are no longer required:
# GOOGLE_GENAI_USE_VERTEXAI=""
# GOOGLE_CLOUD_PROJECT=""
# GOOGLE_CLOUD_LOCATION=""
# GOOGLE_VERTEX_AI_PROJECT_ID=""
# GOOGLE_VERTEX_AI_LOCATION=""
# VERTEX_AI_MODEL=""
# GOOGLE_APPLICATION_CREDENTIALS=""

DEVIL_AI_API_KEY=""
DEVIL_AI_BASE_URL="https://api.devil.ai/v1"
DEVIL_AI_LANG="en"

NODE_ENV="production"
